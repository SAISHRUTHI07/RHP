class Solution {
    public int maxRotateFunction(int[] nums) {
        int sum=0,n=nums.length;
        long val=0,ans=0;
       for(int i=0;i<n;i++){
        sum+=nums[i];
        val+=i*nums[i];
       }
       ans=val;
        for(int i=n-1;i>0;i--){
        val=val-(nums[i]*(n-1))+(sum-nums[i]);
        ans=Math.max(ans,val);
        }
        return (int)ans;
    }
}
