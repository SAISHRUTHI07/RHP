#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#include<set>
#define ll unsigned long long int
using namespace std;
void solve(){
	int n,m;
	ll k;
	cin>>n>>m>>k;
	vector<int>arr(n);
	vector<bool>eaten(n,false);
	for(int i=0;i<n;i++)
	cin>>arr[i];
	ll curr=0;
	for(int i=0;i<n;i++){
		if(i>=m){
			if(eaten[i-m])
			curr-=arr[i-m];
		}
		if(arr[i]+curr<=k){
			cout<<"Yes"<<endl;
			curr+=arr[i];
			eaten[i]=true;
		}
		else{
			cout<<"No"<<endl;
		}
	}
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
