#include<iostream>
#include<map>
using namespace std;
void solve(){
	int N;
	cin>>N;
	map<int,int>m;
	for(int i=0;i<N;i++){
		int curr;
		cin>>curr;
		m[curr]++;
	}
	int ans=0;
	for(auto[num,cnt]:m){
		if(cnt&1){
			ans++;
		}
	}
	cout<<ans<<endl;
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
