#include<iostream>
#include<vector>
#include<algorithm>
#define ll long long int
using namespace std;
void solve(){
	int n;
	cin>>n;
	vector<int> arr(n);
	for(int i=0;i<n;i++){
		cin>>arr[i];
	}
	sort(arr.begin(),arr.end());
	ll ans=0;
	for(int i=0;i<n;i++){
		auto ubit=upper_bound(arr.begin(),arr.end(),arr[i]);
		int ub=arr.end()-ubit;
		auto lbit=lower_bound(arr.begin(),arr.end(),arr[i]);
		int lb=lbit-arr.begin();	
		ans+=1LL*ub*lb;
	}
	cout<<ans;
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
