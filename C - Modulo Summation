#include<iostream>
#include<vector>
using namespace std;
void solve(){
	int n;
	cin>>n;
	vector<int> a(n);
	for(int i=0;i<n;i++)
	cin>>a[i];
	int ans=0;
	for(int i=0;i<n;i++)
	ans+=a[i];
	ans-=n;
	cout<<ans<<endl;
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
