#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
void solve(){
	int N,Q;
	cin>>N>>Q;
	vector<pair<int,int>>arr(Q);
	for(int i=0;i<Q;i++){
		int lt,rt;
		cin>>lt>>rt;
		arr[i]=make_pair(rt,lt);
	}
	sort(arr.begin(),arr.end());
	int count=0,rtmost=0;
	for(auto[rt,lt]:arr){
		if(lt>=rtmost){
			count++;
			rtmost=rt;
			}
	}	
	cout<<count<<endl;
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
