#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
#define ll long long int
using namespace std;
void solve(){
  int n;
  cin>>n;
  vector<int> a(n);
  for(int i=0;i<n;i++)
  cin>>a[i];
  sort(a.begin(),a.end());
  vector<int> ans;
  ll cf=0;
  for(int i=1;i<=a[n-1];i++){
    auto it=lower_bound(a.begin(),a.end(),i);
    int c=a.end()-it;
    cf+=c;
    ans.push_back(cf%10);
    cf=cf/10;
  }
  while(cf>0){
    ans.push_back(cf%10);
    cf=cf/10;
  }
  reverse(ans.begin(),ans.end());
 for(int d:ans) 
	cout << d;
}
int main(){
  ios::sync_with_stdio(false);
  cin.tie(0);
  int tc=1;
  while(tc--)
  solve();
}
