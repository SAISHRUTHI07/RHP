#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
void solve(){
	int n;
	cin>>n;
	vector<pair<int,int>>arr(n);
	for(int i=0;i<n;i++){
		int h,l;
		cin>>h>>l;
		arr[i]=make_pair(h,l);
		}
		sort(arr.begin(),arr.end(),greater<>());
		int prevt=0;
		vector<int>htarr,ltarr;
		for(auto [ht,lt]:arr){
			if(lt>prevt){
				prevt=lt;
				ltarr.push_back(lt);
				htarr.push_back(ht);
			}
		}
		int q;
		cin>>q;
		while(q--){
			int qt;
			cin>>qt;
			auto it=upper_bound(ltarr.begin(),ltarr.end(),qt);
			int index=it-ltarr.begin();
			cout<<htarr[index]<<endl;
	}
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(0);
	int tc=1;
	while(tc--)
	solve();
}
