import java.util.*;
public class Main{
  public static void main(String args[]){
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int a[]=new int[n+1];
    for(int i=1;i<=n;i++)
    a[i]=sc.nextInt();
    int same=0;
    int b=0;
    for(int i=1;i<=n;i++){
      if(i==a[i])
      same++;
      else if(i==a[a[i]])
      b++;
    }
    System.out.println(b/2+1L*same*(same-1)/2);
  }
}
